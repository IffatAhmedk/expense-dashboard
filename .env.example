# Neon (via Vercel Storage) — pooled connection at runtime, direct connection for migrations.
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# The password you type on the sign-in screen.
DASHBOARD_PASSWORD="choose-something-long"
# Random string used to sign the sign-in cookie. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-me"
